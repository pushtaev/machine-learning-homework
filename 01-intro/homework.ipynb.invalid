   "metadata": {},
   "outputs": [],
   "source": [
    "asia_cars = df[df['origin'] == 'Asia']"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 36,
   "id": "014f44a9-2dc3-4b7f-a04a-690db2ebdcc5",
   "metadata": {},
   "outputs": [],
   "source": [
    "selected = asia_cars[['vehicle_weight', 'model_year']]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 37,
   "id": "30e280da-c641-4100-8edc-63d6e71aab62",
   "metadata": {},
   "outputs": [],
   "source": [
    "x = selected.head(7)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 38,
   "id": "bda77568-c345-4a7d-973b-94d4338f9205",
   "metadata": {},
   "outputs": [],
   "source": [
    "X = x.to_numpy()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 39,
   "id": "71bdbca8-6963-46da-959d-28392ad5c712",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[[4240 1996]\n",
      " [4310 1992]\n",
      " [4230 1997]\n",
      " [4420 1978]\n",
      " [3950 2007]\n",
      " [4750 2021]\n",
      " [4450 2019]]\n"
     ]
    }
   ],
   "source": [
    "print(X)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 40,
   "id": "8d9b6f85-901a-498d-a041-e0b39694d8f2",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 41,
   "id": "306294fb-3f5e-45bf-98e2-7d2faf2e84ff",
   "metadata": {},
   "outputs": [],
   "source": [
    "XTX = X.T @ X"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 42,
   "id": "ed84c426-ce30-472b-8a03-2d4807e40acb",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[[131950500  60750580]\n",
      " [ 60750580  28041424]]\n"
     ]
    }
   ],
   "source": [
    "print(XTX)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 43,
   "id": "73ad4f24-2959-446e-9b8d-ce7146cecbc1",
   "metadata": {},
   "outputs": [],
   "source": [
    "XTX_inv = np.linalg.inv(XTX)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 44,
   "id": "70e5eaac-5339-4027-9aa6-216f533f3690",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[[ 2.96830537e-06 -6.43071025e-06]\n",
      " [-6.43071025e-06  1.39675281e-05]]\n"
     ]
    }
   ],
   "source": [
    "print(XTX_inv)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 45,
   "id": "811ef674-a1f7-48e1-bfdb-780dae22d9a7",
   "metadata": {},
   "outputs": [],
   "source": [
    "y = np.array([1100, 1300, 800, 900, 1000, 1100, 1200])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 46,
   "id": "8d1226a8-ba0e-4825-bc31-df2ed0b2fcfe",
   "metadata": {},
   "outputs": [],
   "source": [
    "w = XTX_inv @ X.T @ y  "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 47,
   "id": "46b7c918-1337-4352-a535-61c11fe6cc26",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[0.13644777 0.2327492 ]\n"
     ]
    }
   ],
   "source": [
    "print(w)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 48,
   "id": "cde81a56-b2bd-496d-8e06-f136cff60492",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "0.36919696904925486\n"
     ]
    }
   ],
   "source": [
    "print(w.sum())"
   ]
  },
